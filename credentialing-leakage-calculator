<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Credentialing Leakage Calculator — Inflection Health Partners</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d0f14;
    --surface: #141720;
    --surface2: #1c2030;
    --border: #252a3a;
    --border2: #2e3550;
    --accent: #c8a96e;
    --accent2: #e8c98e;
    --danger: #e05c5c;
    --warning: #e0965c;
    --safe: #5cb88a;
    --text: #e8eaf0;
    --text2: #9aa0b4;
    --text3: #5a6080;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    min-height: 100vh;
    padding: 0;
  }

  /* HEADER */
  header {
    border-bottom: 1px solid var(--border);
    padding: 24px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface);
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .tool-title {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--text3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* HERO */
  .hero {
    padding: 48px 48px 32px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, #141720 0%, #0f1520 100%);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(200,169,110,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 36px;
    line-height: 1.15;
    color: var(--text);
    max-width: 600px;
    margin-bottom: 12px;
  }

  .hero h1 em {
    color: var(--accent);
    font-style: italic;
  }

  .hero p {
    color: var(--text2);
    font-size: 15px;
    max-width: 560px;
    line-height: 1.65;
  }

  /* LAYOUT */
  .main {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 0;
    min-height: calc(100vh - 200px);
  }

  .inputs-panel {
    padding: 40px 48px;
    border-right: 1px solid var(--border);
  }

  .results-panel {
    padding: 40px 32px;
    background: var(--surface);
    position: sticky;
    top: 0;
    height: fit-content;
  }

  /* SECTION HEADERS */
  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .input-group {
    margin-bottom: 32px;
  }

  .input-group-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .input-group-desc {
    font-size: 12px;
    color: var(--text3);
    margin-bottom: 16px;
    line-height: 1.5;
  }

  /* INPUTS */
  .field {
    margin-bottom: 14px;
  }

  .field label {
    display: block;
    font-size: 12px;
    color: var(--text2);
    margin-bottom: 6px;
    font-weight: 500;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .input-wrap {
    position: relative;
  }

  .input-prefix {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text3);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    pointer-events: none;
  }

  .input-suffix {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text3);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    pointer-events: none;
  }

  input[type="number"], input[type="text"] {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 14px;
    padding: 10px 12px;
    border-radius: 4px;
    outline: none;
    transition: border-color 0.2s;
  }

  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  input[type="number"] {
    -moz-appearance: textfield;
    padding-right: 28px;
  }

  input[type="number"]:focus, input[type="text"]:focus {
    border-color: var(--accent);
  }

  /* Custom stepper buttons */
  .num-wrap {
    position: relative;
    display: block;
  }

  .num-wrap input { padding-right: 28px; }
  .num-wrap.has-prefix input { padding-left: 28px; padding-right: 28px; }
  .num-wrap.has-suffix input { padding-right: 52px; }

  .steppers {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 24px;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border);
  }

  .step-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text3);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 1;
    transition: background 0.15s, color 0.15s;
    user-select: none;
  }

  .step-btn:first-child {
    border-bottom: 1px solid var(--border);
    border-radius: 0 4px 0 0;
  }

  .step-btn:last-child {
    border-radius: 0 0 4px 0;
  }

  .step-btn:hover {
    background: var(--border2);
    color: var(--accent);
  }

  .step-btn:active {
    background: var(--border);
    color: var(--accent2);
  }

  /* SLIDER */
  .slider-field {
    margin-bottom: 16px;
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .slider-label {
    font-size: 12px;
    color: var(--text2);
    font-weight: 500;
  }

  .slider-value {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
  }

  input[type="range"] {
    width: 100%;
    -webkit-appearance: none;
    height: 3px;
    background: var(--border2);
    border-radius: 2px;
    outline: none;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  /* DIVIDER */
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }

  /* RESULTS */
  .total-card {
    background: linear-gradient(135deg, #1e1800 0%, #1a1500 100%);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 24px;
    text-align: center;
  }

  .total-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .total-amount {
    font-family: 'DM Serif Display', serif;
    font-size: 40px;
    color: var(--accent2);
    line-height: 1;
    margin-bottom: 4px;
  }

  .total-sub {
    font-size: 11px;
    color: var(--text3);
  }

  /* BREAKDOWN */
  .breakdown {
    margin-bottom: 24px;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .breakdown-row:last-child {
    border-bottom: none;
  }

  .breakdown-name {
    font-size: 12px;
    color: var(--text2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-delay { background: var(--danger); }
  .dot-delegation { background: var(--warning); }
  .dot-retro { background: #a06ed0; }

  .breakdown-amount {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    font-weight: 500;
  }

  .breakdown-amount.danger { color: var(--danger); }
  .breakdown-amount.warning { color: var(--warning); }
  .breakdown-amount.purple { color: #a06ed0; }

  /* BAR CHART */
  .bar-section {
    margin-bottom: 24px;
  }

  .bar-item {
    margin-bottom: 10px;
  }

  .bar-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--text3);
  }

  .bar-track {
    height: 6px;
    background: var(--border2);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .bar-fill.delay { background: var(--danger); }
  .bar-fill.delegation { background: var(--warning); }
  .bar-fill.retro { background: #a06ed0; }

  /* DIAGNOSTIC */
  .diagnostic {
    background: var(--surface2);
    border: 1px solid var(--border2);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 16px;
    margin-top: 20px;
  }

  .diagnostic-header {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .diagnostic-text {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.65;
  }

  .diagnostic-text strong {
    color: var(--text);
    font-weight: 600;
  }

  /* SEVERITY BADGE */
  .severity-badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 2px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .severity-critical { background: rgba(224,92,92,0.15); color: var(--danger); border: 1px solid rgba(224,92,92,0.3); }
  .severity-elevated { background: rgba(224,150,92,0.15); color: var(--warning); border: 1px solid rgba(224,150,92,0.3); }
  .severity-moderate { background: rgba(200,169,110,0.12); color: var(--accent); border: 1px solid rgba(200,169,110,0.25); }

  /* FOOTNOTE */
  .footnote {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--text3);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .main { grid-template-columns: 1fr; }
    .results-panel { position: static; border-top: 1px solid var(--border); border-right: none; }
    header, .hero, .inputs-panel { padding-left: 24px; padding-right: 24px; }
    .results-panel { padding: 32px 24px; }
  }
</style>
</head>
<body>

<header>
  <div class="brand">Inflection Health Partners</div>
  <div class="tool-title">Managed Care Intelligence Suite · Tool 3 of 5</div>
</header>

<div class="hero">
  <h1>Credentialing Leakage<br>Calculator</h1>
  <p>Credentialing delays, delegation failures, and retro-load gaps represent one of the most invisible sources of revenue loss in managed care. This tool quantifies what you're leaving on the table, and why.</p>
</div>

<div class="main">

  <!-- INPUTS -->
  <div class="inputs-panel">

    <!-- SECTION 1: PROVIDER VOLUME -->
    <div class="section-label">Provider Pipeline</div>
    <div class="input-group">
      <div class="input-group-title">New Provider Volume</div>
      <div class="input-group-desc">Providers onboarded per year and their estimated daily revenue contribution once credentialed.</div>
      <div class="field-row">
        <div class="field">
          <label>New providers per year</label>
          <input type="number" id="newProviders" value="18" min="1" step="1" oninput="calc()" onchange="calc()">
        </div>
        <div class="field">
          <label>Avg daily revenue / provider</label>
          <div class="input-wrap has-prefix">
            <span class="input-prefix">$</span>
            <input type="number" id="dailyRevenue" value="1850" min="0" step="50" oninput="calc()" onchange="calc()">
          </div>
        </div>
      </div>
    </div>

    <hr class="divider">

    <!-- SECTION 2: ENROLLMENT DELAY -->
    <div class="section-label">Enrollment Delay</div>
    <div class="input-group">
      <div class="input-group-title">Credentialing Window vs. Actual</div>
      <div class="input-group-desc">The gap between your target credentialing completion time and actual time to payer enrollment is the primary leakage driver.</div>
      <div class="field-row">
        <div class="field">
          <label>Target days to enrollment</label>
          <div class="input-wrap has-suffix">
            <input type="number" id="targetDays" value="45" min="1" step="1" oninput="calc()" onchange="calc()">
            <span class="input-suffix">days</span>
          </div>
        </div>
        <div class="field">
          <label>Actual avg days to enrollment</label>
          <div class="input-wrap has-suffix">
            <input type="number" id="actualDays" value="94" min="1" step="1" oninput="calc()" onchange="calc()">
            <span class="input-suffix">days</span>
          </div>
        </div>
      </div>

      <div class="slider-field">
        <div class="slider-header">
          <span class="slider-label">% of new providers with enrollment delay</span>
          <span class="slider-value" id="delayPctVal">70%</span>
        </div>
        <input type="range" id="delayPct" min="0" max="100" value="70" oninput="document.getElementById('delayPctVal').textContent=this.value+'%'; calc()">
      </div>
    </div>

    <hr class="divider">

    <!-- SECTION 3: DELEGATION FAILURE -->
    <div class="section-label">Delegation Failure</div>
    <div class="input-group">
      <div class="input-group-title">Payer Delegation Breakdown</div>
      <div class="input-group-desc">When a payer's delegation agreement lapses or fails audit, providers require full re-credentialing. This resets the enrollment clock to zero.</div>
      <div class="field-row">
        <div class="field">
          <label>Providers affected per year</label>
          <input type="number" id="delegationProviders" value="2" min="0" step="1" oninput="calc()" onchange="calc()">
        </div>
        <div class="field">
          <label>Avg days lost to re-credentialing</label>
          <div class="input-wrap has-suffix">
            <input type="number" id="delegationDays" value="120" min="0" step="1" oninput="calc()" onchange="calc()">
            <span class="input-suffix">days</span>
          </div>
        </div>
      </div>
    </div>

    <hr class="divider">

    <!-- SECTION 4: RETRO-LOAD GAP -->
    <div class="section-label">Retro-Load Gap</div>
    <div class="input-group">
      <div class="input-group-title">Retroactive Billing Recovery</div>
      <div class="input-group-desc">Most payers allow retroactive billing to a provider's effective date, but only within a window. Revenue outside that window is permanently lost.</div>
      <div class="slider-field">
        <div class="slider-header">
          <span class="slider-label">Payer retro window (days backdated)</span>
          <span class="slider-value" id="retroWindowVal">60 days</span>
        </div>
        <input type="range" id="retroWindow" min="0" max="180" step="15" value="60" oninput="document.getElementById('retroWindowVal').textContent=this.value+' days'; calc()">
        <div id="retroWindowNote" style="font-size:11px;color:var(--text3);margin-top:5px;font-family:'DM Mono',monospace;line-height:1.5"></div>
      </div>
      <div class="slider-field">
        <div class="slider-header">
          <span class="slider-label">% of delayed providers who achieve retro billing</span>
          <span class="slider-value" id="retroSuccessVal">45%</span>
        </div>
        <input type="range" id="retroSuccess" min="0" max="100" value="45" oninput="document.getElementById('retroSuccessVal').textContent=this.value+'%'; calc()">
      </div>
    </div>

    <div class="footnote">
      <strong style="color: var(--text2)">Model assumptions:</strong> All figures represent estimated revenue at risk based on modeled inputs. Actual leakage varies by payer contract terms, specialty, market, and internal credentialing process maturity. Retro-load recovery assumes clean documentation and timely submission. Delegation failure days are illustrative of typical re-credentialing cycles. This tool is designed for operational diagnostics and planning -- not for audit or legal purposes.
    </div>

  </div>

  <!-- RESULTS -->
  <div class="results-panel">

    <div class="section-label" style="margin-bottom: 16px;">Revenue at Risk</div>

    <div id="severityBadge" class="severity-badge severity-critical">Critical Exposure</div>

    <div class="total-card">
      <div class="total-label">Estimated Annual Leakage</div>
      <div class="total-amount" id="totalLeakage">$0</div>
      <div class="total-sub">estimated annual revenue at risk</div>
    </div>

    <div class="breakdown">
      <div class="breakdown-row">
        <div class="breakdown-name"><span class="dot dot-delay"></span>Hard delay loss (beyond retro reach)</div>
        <div style="text-align:right">
          <div class="breakdown-amount danger" id="delayLoss">$0</div>
          <div id="hardLossNote" style="font-size:10px;color:var(--text3);font-family:'DM Mono',monospace;display:none">retro window covers full delay</div>
        </div>
      </div>
      <div class="breakdown-row">
        <div class="breakdown-name"><span class="dot dot-delegation"></span>Delegation failure losses</div>
        <div class="breakdown-amount warning" id="delegationLoss">$0</div>
      </div>
      <div class="breakdown-row">
        <div class="breakdown-name"><span class="dot dot-retro"></span>Retro-eligible gap — operationally fixable ↩</div>
        <div class="breakdown-amount purple" id="retroLoss">$0</div>
      </div>
    </div>

    <!-- Gross/net reconciliation -->
    <div style="border-top:1px solid var(--border2);margin:4px 0 12px;padding-top:10px">
      <div style="display:flex;justify-content:space-between;font-family:'DM Mono',monospace;font-size:11px;color:var(--text3);margin-bottom:4px">
        <span>Gross delay exposure</span><span id="grossDelayDisplay">$0</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-family:'DM Mono',monospace;font-size:11px;color:var(--safe);margin-bottom:6px">
        <span>Less: retro recovered</span><span id="retroRecoveredDisplay">−$0</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-family:'DM Mono',monospace;font-size:11px;color:var(--text2);border-top:1px solid var(--border);padding-top:5px">
        <span>Net delay at risk</span><span id="netDelayDisplay">$0</span>
      </div>
    </div>

    <div class="bar-section">
      <div class="bar-item">
        <div class="bar-meta"><span>Hard delay loss</span><span id="delayPct2">0%</span></div>
        <div class="bar-track"><div class="bar-fill delay" id="delayBar" style="width:0%"></div></div>
      </div>
      <div class="bar-item">
        <div class="bar-meta"><span>Delegation failure</span><span id="delegationPct2">0%</span></div>
        <div class="bar-track"><div class="bar-fill delegation" id="delegationBar" style="width:0%"></div></div>
      </div>
      <div class="bar-item">
        <div class="bar-meta"><span>Retro-eligible gap</span><span id="retroPct2">0%</span></div>
        <div class="bar-track"><div class="bar-fill retro" id="retroBar" style="width:0%"></div></div>
      </div>
    </div>

    <div class="diagnostic">
      <div class="diagnostic-header">Diagnostic</div>
      <div class="diagnostic-text" id="diagnosticText">Calculating...</div>
    </div>

  </div>
</div>

<script>
function fmt(n) {
  if (n >= 1000000) return '$' + (n/1000000).toFixed(2) + 'M';
  if (n >= 1000) return '$' + Math.round(n/1000) + 'K';
  return '$' + Math.round(n);
}

function calc() {
  const newProviders = parseFloat(document.getElementById('newProviders').value) || 0;
  const dailyRevenue = parseFloat(document.getElementById('dailyRevenue').value) || 0;
  const targetDays = parseFloat(document.getElementById('targetDays').value) || 0;
  const actualDays = parseFloat(document.getElementById('actualDays').value) || 0;
  const delayPct = parseFloat(document.getElementById('delayPct').value) / 100;
  const delegationProviders = parseFloat(document.getElementById('delegationProviders').value) || 0;
  const delegationDays = parseFloat(document.getElementById('delegationDays').value) || 0;
  const retroWindow = parseFloat(document.getElementById('retroWindow').value) || 0;
  const retroSuccess = parseFloat(document.getElementById('retroSuccess').value) / 100;

  // --- ENROLLMENT DELAY LOSS ---
  const delayDays = Math.max(0, actualDays - targetDays);
  const delayedProviders = newProviders * delayPct;
  const grossDelayLoss = delayedProviders * delayDays * dailyRevenue;

  // Split delay loss into two mutually exclusive buckets — no double-count
  // Hard loss: days beyond the retro window — permanently irrecoverable
  const hardDelayLoss = delayedProviders * Math.max(0, delayDays - retroWindow) * dailyRevenue;
  // Soft loss: days within retro window but not successfully filed — operationally fixable
  const retroRecoveryRate = delayDays > 0 ? (Math.min(retroWindow, delayDays) / delayDays) : 0;
  const softDelayLoss = grossDelayLoss * retroRecoveryRate * (1 - retroSuccess);
  // Identity check: hardDelayLoss + softDelayLoss + (grossDelayLoss * retroRecoveryRate * retroSuccess) = grossDelayLoss

  // --- DELEGATION FAILURE LOSS ---
  const delegationLoss = delegationProviders * delegationDays * dailyRevenue;

  const retroRecoveredAmt = grossDelayLoss * retroRecoveryRate * retroSuccess;

  const total = hardDelayLoss + softDelayLoss + delegationLoss;

  // Render
  document.getElementById('totalLeakage').textContent = fmt(total);
  document.getElementById('delayLoss').textContent = fmt(hardDelayLoss);
  document.getElementById('delegationLoss').textContent = fmt(delegationLoss);
  document.getElementById('retroLoss').textContent = fmt(softDelayLoss);


  // Gross/net reconciliation panel
  document.getElementById('grossDelayDisplay').textContent = fmt(grossDelayLoss);
  document.getElementById('retroRecoveredDisplay').textContent = '−' + fmt(retroRecoveredAmt);
  document.getElementById('netDelayDisplay').textContent = fmt(hardDelayLoss + softDelayLoss);

  // Show note when hard loss is $0 (retro window covers full delay)
  const hardNote = document.getElementById('hardLossNote');
  hardNote.style.display = (hardDelayLoss === 0 && delayDays > 0) ? 'block' : 'none';

  // Retro window contextual note
  const retroWindowNote = document.getElementById('retroWindowNote');
  if (delayDays === 0) {
    retroWindowNote.textContent = '';
  } else if (retroWindow >= delayDays) {
    retroWindowNote.textContent = `↳ window covers your full ${Math.round(delayDays)}-day delay gap — hard loss = $0`;
  } else {
    retroWindowNote.textContent = `↳ ${Math.round(retroWindow)} of ${Math.round(delayDays)} delay days are retro-eligible — ${Math.round(delayDays - retroWindow)} days create hard loss`;
  }

  // Bars
  const maxBar = Math.max(hardDelayLoss, delegationLoss, softDelayLoss, 1);
  document.getElementById('delayBar').style.width = (hardDelayLoss / maxBar * 100) + '%';
  document.getElementById('delegationBar').style.width = (delegationLoss / maxBar * 100) + '%';
  document.getElementById('retroBar').style.width = (softDelayLoss / maxBar * 100) + '%';

  const delayShare = total > 0 ? Math.round(hardDelayLoss / total * 100) : 0;
  const delegationShare = total > 0 ? Math.round(delegationLoss / total * 100) : 0;
  const retroShare = total > 0 ? 100 - delayShare - delegationShare : 0;

  document.getElementById('delayPct2').textContent = delayShare + '%';
  document.getElementById('delegationPct2').textContent = delegationShare + '%';
  document.getElementById('retroPct2').textContent = retroShare + '%';

  // Severity
  const badge = document.getElementById('severityBadge');
  if (total >= 1000000) {
    badge.className = 'severity-badge severity-critical';
    badge.textContent = 'Critical Exposure';
  } else if (total >= 400000) {
    badge.className = 'severity-badge severity-elevated';
    badge.textContent = 'Elevated Exposure';
  } else {
    badge.className = 'severity-badge severity-moderate';
    badge.textContent = 'Moderate Exposure';
  }

  // Diagnostic narrative
  let diag = '';
  const avgDelayDays = actualDays - targetDays;

  if (total === 0) {
    diag = 'Enter your provider pipeline and credentialing data to generate a leakage estimate.';
  } else {
    const dominantCategory = hardDelayLoss >= delegationLoss && hardDelayLoss >= softDelayLoss ? 'delay'
                           : delegationLoss >= softDelayLoss ? 'delegation' : 'retro';

    if (dominantCategory === 'delay') {
      diag = `<strong>Hard delay loss is your primary driver.</strong> With providers averaging <strong>${Math.round(actualDays)} days</strong> to enrollment against a <strong>${Math.round(targetDays)}-day target</strong>, you're losing <strong>${Math.round(delayDays)} billable days per provider</strong> beyond the retro window — permanently irrecoverable. `;
      if (retroSuccess < 0.5) {
        diag += `Your retro-billing recovery rate is also low — meaning a significant share of the <em>retro-eligible</em> window is going unfiled. Improving retro submission processes is an operationally fixable loss that doesn't require speeding up credentialing at all.`;
      } else {
        diag += `Your retro recovery rate is working within the window, but your payer retro window only reaches back <strong>${Math.round(retroWindow)} days</strong> — anything beyond that is gone permanently.`;
      }
    } else if (dominantCategory === 'delegation') {
      diag = `<strong>Delegation failure is your primary driver.</strong> Re-credentialing <strong>${Math.round(delegationProviders)} providers per year</strong> at <strong>${Math.round(delegationDays)} days each</strong> creates a compounding revenue gap that enrollment process improvements alone won't solve. Delegation audit failures require a payer relations strategy — not just a faster credentialing desk.`;
    } else {
      diag = `<strong>Soft delay loss is your primary opportunity.</strong> Credentialing delays are happening within your retro window, meaning the revenue is technically claimable, but only <strong>${Math.round(retroSuccess*100)}% of eligible providers</strong> are achieving retro billing. This is an operationally fixable problem. A focused retro submission process improvement could recover a meaningful share of this loss without any change to credentialing speed. This is the highest-ROI fix available to you right now.`;
    }

    if (total >= 1000000) {
      diag += ` <strong>At ${fmt(total)} in estimated annual leakage, this is a seven-figure operational problem.</strong>`;
    } else if (total >= 500000) {
      diag += ` <strong>At ${fmt(total)}, this is a material operational issue that warrants dedicated process attention.</strong>`;
    }
  }

  document.getElementById('diagnosticText').innerHTML = diag;
}

// Init
calc();

// Inject custom stepper buttons on all number inputs
document.querySelectorAll('input[type="number"]').forEach(input => {
  const parent = input.parentElement;

  // Create wrapper
  const wrap = document.createElement('div');
  wrap.className = 'num-wrap' +
    (parent.classList.contains('has-prefix') ? ' has-prefix' : '') +
    (parent.classList.contains('has-suffix') ? ' has-suffix' : '');

  // Move prefix/suffix spans into wrapper too
  parent.insertBefore(wrap, input);
  wrap.appendChild(input);

  // Move prefix/suffix if present
  [...parent.querySelectorAll('.input-prefix, .input-suffix')].forEach(el => wrap.appendChild(el));

  // Stepper container
  const steppers = document.createElement('div');
  steppers.className = 'steppers';

  const up = document.createElement('button');
  up.className = 'step-btn';
  up.innerHTML = '▲';
  up.type = 'button';
  up.setAttribute('tabindex', '-1');

  const dn = document.createElement('button');
  dn.className = 'step-btn';
  dn.innerHTML = '▼';
  dn.type = 'button';
  dn.setAttribute('tabindex', '-1');

  const step = parseFloat(input.step) || 1;

  up.addEventListener('mousedown', e => {
    e.preventDefault();
    input.value = (parseFloat(input.value) || 0) + step;
    calc();
  });

  dn.addEventListener('mousedown', e => {
    e.preventDefault();
    const min = parseFloat(input.min) ?? 0;
    input.value = Math.max(min, (parseFloat(input.value) || 0) - step);
    calc();
  });

  steppers.appendChild(up);
  steppers.appendChild(dn);
  wrap.appendChild(steppers);
});
</script>
</body>
</html>
